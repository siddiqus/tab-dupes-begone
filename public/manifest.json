{
  "manifest_version": 3,
  "name": "Tab Dupes Begone",
  "version": "0.0.0",
  "description": "Switch to the tab you already have open instead of opening a duplicate. Choose which kinds of links it applies to.",
  "homepage_url": "https://github.com/siddiqus/tab-dupes-begone",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["tabs", "webNavigation", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Tab Dupes Begone",
    "default_popup": "popup.html"
  },
  "minimum_chrome_version": "121"
}
