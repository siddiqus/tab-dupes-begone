{
  "manifest_version": 3,
  "name": "Tab Dupes Begone",
  "version": "0.0.0",
  "description": "Links from desktop apps switch to the tab you already have open instead of opening a duplicate.",
  "homepage_url": "https://github.com/siddiqus/tab-dupes-begone",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["tabs", "webNavigation", "storage"],
  "background": { "service_worker": "background.js", "type": "module" },
  "minimum_chrome_version": "121"
}
